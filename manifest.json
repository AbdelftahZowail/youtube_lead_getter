{
  "manifest_version": 2,
  "name": "ext",
  "version": "1.0",
  "description": "DANGER",
  "permissions": ["storage", "downloads"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "Untitled.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}